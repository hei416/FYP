# ============================================
# Database Configuration
# ============================================
# Copy this file to .env and fill in your values.

# Option 1: SQLite (local dev only - NOT recommended for production)
# DATABASE_URL=sqlite:///./learning_platform.db

# Option 2: PostgreSQL (recommended for production)
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_db_name

# Examples:
#   Render:    postgresql://user:pass@dpg-xxxx.oregon-postgres.render.com/fyp_db
#   Railway:   postgresql://postgres:pass@containers-us-west-xxx.railway.app:6543/railway
#   Supabase:  postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
#   Local:     postgresql://postgres:password@localhost:5432/fyp_db
