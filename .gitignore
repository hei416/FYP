# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build/
dist/

# ── Environment variables (never commit real values) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Databases (SQLite lives in /home on Azure; exclude from source) ──
*.db

# ── Vector stores ──
# FAISS binaries in vectorstore/ ARE committed on purpose for fast production
# startup (Option B). Do NOT add a rule that ignores vectorstore/.
# index.faiss

# ── Model caches (local development only) ──
.cache/
sentence_transformers_cache/

# ── IDE / OS ──
.vscode/
.idea/
.VSCodeCounter/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Misc ──
*.log
deploy.zip
migrate_to_postgres.py

# Single-process container builds: CI drops the React build here before
# `docker build backend/`. The directory is tracked (placeholder only) so the
# Dockerfile COPY always resolves; its contents never are.
backend/frontend_build/*
!backend/frontend_build/.gitkeep
