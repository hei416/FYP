# NOTE: this file is meant to live as `.env.example` (README known issue #8).
# It was created as `env.example` because the owner's Claude Code user-level
# permission rules deny writing any `.env.*` path. To finish:  mv env.example .env.example
#
# Copy to .env and fill in real values. Never commit .env.
# Source of truth for the variable list: README.md "Environment Variables".

# LLM API (HKBU gateway)
API_KEY=your_hkbu_api_key

# Code execution (Paiza)
PAIZA_API_KEY=your_paiza_key

# Security — JWT signing key
SECRET_KEY=your_jwt_secret_key

# Development only — enables /test-alive and /debug/routes.
# Must be false or unset in production.
DEBUG_MODE=true

# Database — leave blank for the SQLite default (learning_platform.db);
# set a PostgreSQL URL in production.
DATABASE_URL=

# CORS origin allowlist (SEC-8) — comma-separated. Defaults to the local dev
# frontend; MUST be set to the real frontend origin at deploy time.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend build served by the backend (single-process mode). Leave unset in
# development — CRA serves :3000 and the backend stays API-only.
FRONTEND_BUILD_DIR=
